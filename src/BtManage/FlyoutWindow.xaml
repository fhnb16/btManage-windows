<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BtManage.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:BtManage.Views">
    <Grid x:Name="Root" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Devices in range -->
        <StackPanel x:Name="DevicePanel" Padding="16" Spacing="16">
            <views:DeviceCard x:Name="Nearest" />
            <StackPanel x:Name="OtherDevices"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,8,0,0" />
        </StackPanel>

        <!-- Nothing in range, or Bluetooth is off -->
        <StackPanel x:Name="EmptyPanel" Padding="16,24" Spacing="4" Visibility="Collapsed">
            <TextBlock x:Name="EmptyTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="EmptyHint"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="4,8">
            <HyperlinkButton x:Name="SettingsButton" Padding="12,6" Click="OnSettingsClick">
                <HyperlinkButton.Resources>
                    <!-- A quiet link: the accent is kept for the charge meters. -->
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </HyperlinkButton.Resources>
            </HyperlinkButton>
        </Border>
    </Grid>
</Window>
