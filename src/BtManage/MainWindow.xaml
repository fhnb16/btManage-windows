<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BtManage.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:BtManage.Views">
    <Grid x:Name="Root" Background="{ThemeResource BtmWindowBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <!-- 8 in the Fluent look; the Material look raises it (Appearance.ApplyDesign). -->
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the window is dragged by it -->
        <StackPanel x:Name="TitleBar" Orientation="Horizontal" Spacing="12" Padding="16,0,0,0">
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Devices on the left, settings pinned under them -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView x:Name="DeviceList"
                          SelectionMode="Single"
                          SelectionChanged="OnDeviceSelected" />
                <ListView x:Name="FooterList"
                          Grid.Row="1"
                          SelectionMode="Single"
                          SelectionChanged="OnFooterSelected"
                          Padding="0,4,0,8"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="0,1,0,0" />
            </Grid>

            <Border Grid.Column="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- The content fills the pane up to a comfortable reading width, from the left. -->
                    <Grid Padding="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="760" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- One device -->
                        <StackPanel x:Name="DevicePanel" Spacing="16" Visibility="Collapsed">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon x:Name="HeaderIcon"
                                          FontSize="28"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="HeaderName"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HeaderSummary"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="ConnectButton" MinWidth="112" Click="OnConnectClick" Visibility="Collapsed" />
                                    <Button x:Name="MoreButton" Width="36" Height="32" Padding="0">
                                        <FontIcon Glyph="&#xE712;" FontSize="16" />
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem x:Name="ForgetItem" Click="OnForgetClick" />
                                                <MenuFlyoutItem x:Name="WindowsSettingsItem" Click="OnWindowsSettingsClick" />
                                                <MenuFlyoutSeparator x:Name="RemoveSeparator" />
                                                <MenuFlyoutItem x:Name="RemoveItem" Click="OnRemoveClick" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="16">
                                    <TextBlock x:Name="BatteryTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <views:DeviceCard x:Name="BatteryCard" Width="328" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="BatteryNote"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="HistoryPanel" Style="{StaticResource Card}">
                                <StackPanel Spacing="16">
                                    <TextBlock x:Name="HistoryTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <views:HistoryChart x:Name="Chart" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="InfoTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <StackPanel x:Name="InfoRows" Spacing="8" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="16,8">
                                <Grid>
                                    <TextBlock x:Name="NotifyLabel" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="NotifySwitch"
                                                  HorizontalAlignment="Right"
                                                  MinWidth="0"
                                                  OnContent=""
                                                  OffContent=""
                                                  Toggled="OnNotifyToggled" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Settings; the rows are built in code -->
                        <StackPanel x:Name="SettingsPanel" Spacing="4" Visibility="Collapsed" />

                        <!-- Sharing with other devices; built in code (MainWindow.Share.cs) -->
                        <StackPanel x:Name="SharePanel" Spacing="12" Visibility="Collapsed" />

                        <!-- No device to show -->
                        <StackPanel x:Name="PlaceholderPanel" Spacing="4" Visibility="Collapsed">
                            <TextBlock x:Name="PlaceholderTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="PlaceholderHint"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
