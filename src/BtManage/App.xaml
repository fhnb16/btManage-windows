<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BtManage.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- What lies behind the content of a window. Appearance.ApplyDesign fills these
                 in for the design and backdrop chosen; until then the backdrop shows through. -->
            <!-- Colours for elements made in code. A brush taken from the resources in code
                 keeps the theme of the application; a style's theme resource follows the
                 theme of the element, which the settings can change while the application
                 runs (Appearance.ApplyWindow). -->
            <Style x:Key="BtmWindowRootStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource BtmWindowBackgroundBrush}" />
            </Style>
            <Style x:Key="BtmPrimaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="BtmSecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="BtmTertiaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="BtmCriticalTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="BtmSecondaryCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="BtmTertiaryCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="BtmSecondaryIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="BtmChartGridStyle" TargetType="Line">
                <Setter Property="Stroke" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="BtmChartLeadLineStyle" TargetType="Polyline">
                <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="BtmChartSecondaryLineStyle" TargetType="Polyline">
                <Setter Property="Stroke" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="BtmChartTertiaryLineStyle" TargetType="Polyline">
                <Setter Property="Stroke" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="BtmChartLeadSwatchStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="BtmChartSecondarySwatchStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="BtmChartTertiarySwatchStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BtmWindowBackgroundBrush" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BtmWindowBackgroundBrush" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="BtmWindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
